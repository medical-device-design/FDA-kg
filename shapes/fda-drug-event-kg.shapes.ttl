# Generated by pipeline/gen_shapes.py for fda-drug-event-kg. Do not edit by hand.
shp:AdverseEventReportShape a sh:NodeShape ;
    sh:targetClass ex:AdverseEventReport ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ; sh:datatype xsd:string ] ;
    sh:or (
        [ sh:property [ sh:path ex:isStub ; sh:hasValue true ] ]
        [ sh:property [ sh:path ex:sourceDataset ; sh:minCount 1 ; sh:datatype xsd:string ] ;
          sh:property [ sh:path ex:sourceRecordId ; sh:minCount 1 ] ;
          sh:property [ sh:path ex:sourceUrl ; sh:minCount 1 ] ;
          sh:property [ sh:path ex:retrievedAt ; sh:minCount 1 ; sh:datatype xsd:date ] ]
    ) ;
    sh:property [ sh:path ex:hasSubstance ; sh:nodeKind sh:IRI ; sh:pattern "^https://bmedesign.org/fda-substance-kg/id/unii/" ] ;
    sh:property [ sh:path ex:hasApplication ; sh:nodeKind sh:IRI ; sh:pattern "^https://bmedesign.org/fda-drug-biologic-kg/id/application/" ] ;
    sh:property [ sh:path ex:hasPackageNdc ; sh:nodeKind sh:IRI ; sh:pattern "^https://bmedesign.org/fda-drug-biologic-kg/id/ndc-package/" ] ;
    sh:property [ sh:path ex:receivedate ; sh:or ( [ sh:datatype xsd:date ] [ sh:datatype xsd:string ] ) ] ;
    sh:property [ sh:path ex:receiptdate ; sh:or ( [ sh:datatype xsd:date ] [ sh:datatype xsd:string ] ) ] ;
    sh:property [ sh:path ex:transmissiondate ; sh:or ( [ sh:datatype xsd:date ] [ sh:datatype xsd:string ] ) ] ;
    sh:property [ sh:path ex:safetyreportid ; sh:minCount 1 ; sh:maxCount 1 ] .

