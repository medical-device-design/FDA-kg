# Food ingredient inventories -> fda-substance-kg: which inventories list the same substance, keyed by the
# substance IRI (one row per substance even when GSRS has two name spellings)
PREFIX f: <https://bmedesign.org/fda-food-cosmetic-kg/ns/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?sub (SAMPLE(?substanceLabel) AS ?substance) (COUNT(DISTINCT ?class) AS ?inventories) (GROUP_CONCAT(DISTINCT STRAFTER(STR(?class), "ns/"); separator=", ") AS ?classes) WHERE {
  ?x a ?class ; f:hasSubstance ?sub . OPTIONAL { ?sub rdfs:label ?substanceLabel }
} GROUP BY ?sub HAVING (COUNT(DISTINCT ?class) >= 3) ORDER BY DESC(?inventories) LIMIT 15
